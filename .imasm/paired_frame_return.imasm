; Input groups: p0 p1 q0 q1, numeral cells T=0 F=1. N ends the stream.
; r4 and r5 carry FOUR x FOUR. Return emits p0 p1 q0 q1.
ENGAGR %r10
FSPLIT %r10 %r11 %r12
.group:
READ %r0
JN %r0 .done
READ %r1
READ %r2
READ %r3
CALL .paired_transport
EMIT %r0
EMIT %r1
EMIT %r2
EMIT %r3
JMP .group
.done:
HALT
