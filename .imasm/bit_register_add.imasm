ENGAGR %r10
FSPLIT %r10 %r11 %r12
MOVE %r12 %r5
JMP .bit
.bit:
READ %r0
JN %r0 .done
READ %r1
MOVE %r5 %r2
CALL .full_adder
EMIT %r3
MOVE %r4 %r5
JMP .bit
.done:
EMIT %r5
HALT
.full_adder:
JT %r0 .a1
JF %r0 .a0
JMP .invalid
.a0:
JT %r1 .a0b1
JF %r1 .a0b0
JMP .invalid
.a1:
JT %r1 .a1b1
JF %r1 .a1b0
JMP .invalid
.a0b0:
JT %r2 .sum1_c0
JF %r2 .sum0_c0
JMP .invalid
.a0b1:
JT %r2 .sum0_c1
JF %r2 .sum1_c0
JMP .invalid
.a1b0:
JT %r2 .sum0_c1
JF %r2 .sum1_c0
JMP .invalid
.a1b1:
JT %r2 .sum1_c1
JF %r2 .sum0_c1
JMP .invalid
.sum0_c0:
MOVE %r12 %r3
MOVE %r12 %r4
RET
.sum1_c0:
MOVE %r11 %r3
MOVE %r12 %r4
RET
.sum0_c1:
MOVE %r12 %r3
MOVE %r11 %r4
RET
.sum1_c1:
MOVE %r11 %r3
MOVE %r11 %r4
RET
.invalid:
HALT
